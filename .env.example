# ==============================================================================
# HOSPITAL MANAGEMENT SYSTEM (HMS / EMR) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL Dual-URL Architecture)
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler (Port 6543) - used by Next.js application runtime
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Direct session connection (Port 5432) - used by Drizzle Kit migrations & schema push
DIRECT_DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Serverless connection pooler limit (Recommended: 4 in production, 8 in dev)
DB_MAX_CONNECTIONS=4

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & STORAGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="super-secret-jwt-token"

# ------------------------------------------------------------------------------
# 3. OFFLINE CLINICAL CONTINUITY (HMAC-SHA256 Session Signature Secret)
# ------------------------------------------------------------------------------
ENCRYPTION_SECRET="hms-clinical-offline-hmac-sha256-salt-change-in-production"

# ------------------------------------------------------------------------------
# 4. OFFICIAL META WHATSAPP BUSINESS CLOUD API (WABA v20+)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="100000000000001"
WHATSAPP_BUSINESS_ACCOUNT_ID="200000000000002"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_WEBHOOK_VERIFY_TOKEN="hms-waba-webhook-secret-token"

# ------------------------------------------------------------------------------
# 5. ABDM (AYUSHMAN BHARAT DIGITAL MISSION) - NHA SANDBOX / PRODUCTION
# ------------------------------------------------------------------------------
ABDM_BASE_URL="https://dev.abdm.gov.in/gateway/v0.5"
ABDM_CLIENT_ID="SBX_HMS_001"
ABDM_CLIENT_SECRET="nha-abdm-client-secret"
ABDM_HIP_ID="IN01100001"
ABDM_MOCK_MODE="true"

# ------------------------------------------------------------------------------
# 6. APPLICATION METADATA & BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Apex HMS & Clinical EMR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
